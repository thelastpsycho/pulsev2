# GuestPulse Frontend - Production Environment
# This file is used for production builds

# API Configuration - Set this to your production API URL
VITE_API_BASE_URL=https://pulse-api.anvayabali.com/api

# Application Configuration
VITE_APP_NAME="GuestPulse"
VITE_APP_ENV=production

# Feature Flags - MUST be false in production
VITE_ENABLE_MOCK_DATA=false